{
  "name": "@map-colonies/vector-standard-db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp ./src/openapi.d.ts ./dist/openapi.d.ts",
    "dev": "tsc --watch",
    "typeorm": "node --require ts-node/register ../../node_modules/typeorm/cli.js -d dataSource.ts",
    "migration:generate": "npm run typeorm migration:generate src/migrations/Migration",
    "migration:run": "npm run typeorm migration:run",
    "generate:openapi-types": "openapi-helpers generate types ../../openapi3.yaml ./src/openapi.d.ts --format --add-typed-request-handler"
  },
  "dependencies": {
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/schemas": "*",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typeorm": "^0.3.20"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
