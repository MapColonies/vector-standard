{
  "name": "@map-colonies/vector-standard-synchronizer",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && node dist/src/index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./src/index.js",
    "dev": "ts-node src/index.ts",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles -f  copyfiles ./package.json dist",
    "watch": "ts-node-dev --respawn src/index.ts",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/cleanup-registry": "^1.3.0",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/error-express-handler": "^4.0.0",
    "@map-colonies/express-access-log-middleware": "^5.0.0",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/openapi-helpers": "^5.1.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^2.0.0",
    "@map-colonies/schemas": "*",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@smithy/node-http-handler": "^4.7.6",
    "axios": "^1.7.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "type-fest": "^4.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/nock": "^10.0.3",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "nock": "^14.0.15",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typeorm": "^0.3.20"
  }
}
